
{
  "rules": {
    ".read": false,
    ".write": false,

    "allowedTeachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "teachers": {
      "$uid": {
        "settings": {
          ".validate": "newData.hasChildren()",
          ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true",
          "displayName": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "defaultTimer": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
          },
          "defaultMode": {
            ".validate": "newData.val() === 'classic' || newData.val() === 'speed'"
          },
          "showResultsEachQuestion": {
            ".validate": "newData.isBoolean()"
          },
          "sections": {
            "$sectionId": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            }
          },
          "$other": {
            ".validate": false
          }
        },

        "questions": {
          ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true",
          ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true",
          "$questionId": {
            ".validate": "newData.hasChildren(['grade', 'topic', 'text', 'choices', 'correctIndex', 'createdAt', 'updatedAt'])",
            "grade": {
              ".validate": "newData.isNumber() && (newData.val() === 10 || newData.val() === 11 || newData.val() === 12)"
            },
            "topic": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "choices": {
              ".validate": "newData.hasChildren(['0', '1', '2', '3'])",
              "$i": {
                ".validate": "($i === '0' || $i === '1' || $i === '2' || $i === '3') && newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
              }
            },
            "correctIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "explanation": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },

    "gamePins": {
      "$pin": {
        ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'anonymous' || (auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true))",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",
        ".validate": "!newData.exists() || (newData.hasChildren(['gameId', 'ownerUid', 'status', 'createdAt']) && newData.child('gameId').isString() && newData.child('ownerUid').val() === auth.uid && newData.child('status').isString() && newData.child('createdAt').isNumber())",
        "gameId": {
          ".validate": "newData.isString()"
        },
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.val() === 'waiting'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "games": {
      "$gameId": {
        ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous') || (auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && data.child('ownerUid').val() === auth.uid))",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && ((data.exists() && data.child('ownerUid').val() === auth.uid) || (!data.exists() && newData.child('ownerUid').val() === auth.uid))",
        ".validate": "!newData.exists() || newData.hasChildren(['ownerUid', 'grade', 'topic', 'mode', 'timer', 'questionCount', 'status', 'createdAt'])",
        "ownerUid": {
          ".validate": "newData.isString()"
        },
        "grade": {
          ".validate": "newData.isNumber() && (newData.val() === 10 || newData.val() === 11 || newData.val() === 12)"
        },
        "topic": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "mode": {
          ".validate": "newData.val() === 'classic' || newData.val() === 'speed'"
        },
        "progressionMode": {
          ".validate": "newData.val() === 'synchronized' || newData.val() === 'individual'"
        },
        "timer": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
        },
        "questionCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'paused' || newData.val() === 'finished' || newData.val() === 'cancelled'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "currentQuestionIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 49"
        },
        "currentQuestion": {
          ".validate": "newData.hasChildren(['text', 'choices'])",
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
          },
          "choices": {
            ".validate": "newData.hasChildren(['0', '1', '2', '3'])",
            "$i": {
              ".validate": "($i === '0' || $i === '1' || $i === '2' || $i === '3') && newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "questionStartedAt": {
          ".validate": "newData.isNumber()"
        },
        "answerDeadline": {
          ".validate": "newData.isNumber()"
        },
        "answerRevealed": {
          ".validate": "newData.isBoolean()"
        },
        "revealedCorrectIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "revealedExplanation": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "pausedRemaining": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "gamePrivate": {
      "$gameId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && data.child('ownerUid').val() === auth.uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",
        ".validate": "!newData.exists() || newData.hasChildren(['ownerUid', 'questions'])"
      }
    },

    "gameStudentState": {
      "$gameId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous' && auth.uid === $uid) || (auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid))",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['currentQuestionIndex', 'currentQuestion', 'questionStartedAt', 'answerDeadline', 'answerRevealed'])",
          "currentQuestionIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 49"
          },
          "currentQuestion": {
            ".validate": "newData.hasChildren(['text', 'choices'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 500"
            },
            "choices": {
              ".validate": "newData.hasChildren(['0', '1', '2', '3'])",
              "$i": {
                ".validate": "($i === '0' || $i === '1' || $i === '2' || $i === '3') && newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "questionStartedAt": {
            ".validate": "newData.isNumber()"
          },
          "answerDeadline": {
            ".validate": "newData.isNumber()"
          },
          "answerRevealed": {
            ".validate": "newData.isBoolean()"
          },
          "revealedCorrectIndex": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          },
          "revealedExplanation": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "pausedRemaining": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
          },
          "status": {
            ".validate": "newData.val() === 'waiting' || newData.val() === 'active' || newData.val() === 'paused' || newData.val() === 'finished' || newData.val() === 'completed'"
          },
          "finished": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "gamePlayers": {
      "$gameId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous' && auth.uid === $uid) || (auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid))",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && auth.uid === $uid && root.child('games').child($gameId).child('status').val() === 'waiting'",
          ".validate": "newData.hasChildren(['name', 'section', 'joinedAt'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "section": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "joinedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "gameAnswers": {
      "$gameId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        "$uid": {
          ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'anonymous' && auth.uid === $uid) || (auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid))",
          "$questionKey": {
            ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && auth.uid === $uid && root.child('games').child($gameId).child('status').val() === 'active' && !data.exists() && ((root.child('games').child($gameId).child('progressionMode').val() === 'individual' && root.child('gameStudentState').child($gameId).child($uid).child('answerRevealed').val() !== true && newData.child('questionIndex').val() === root.child('gameStudentState').child($gameId).child($uid).child('currentQuestionIndex').val()) || (root.child('games').child($gameId).child('progressionMode').val() !== 'individual' && root.child('games').child($gameId).child('answerRevealed').val() !== true && newData.child('questionIndex').val() === root.child('games').child($gameId).child('currentQuestionIndex').val()))",
            ".validate": "newData.hasChildren(['questionIndex', 'choiceIndex', 'submittedAt'])",
            "questionIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 49"
            },
            "choiceIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "submittedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },

    "gameScores": {
      "$gameId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && root.child('games').child($gameId).child('ownerUid').val() === auth.uid",
        "$uid": {
          ".validate": "newData.hasChildren(['name', 'section', 'score', 'correct', 'answered'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "section": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "correct": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "answered": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "rank": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "gameHistory": {
      "$teacherUid": {
        ".read": "auth != null && auth.uid === $teacherUid && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true",
        "$gameId": {
          ".write": "auth != null && auth.uid === $teacherUid && auth.token.firebase.sign_in_provider === 'password' && root.child('allowedTeachers').child(auth.uid).val() === true && ((!data.exists() && newData.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('ownerUid').val() === auth.uid))",
          ".validate": "!newData.exists() || newData.hasChildren(['ownerUid', 'grade', 'topic', 'mode', 'timer', 'questionCount', 'createdAt', 'finishedAt', 'status', 'playerCount'])",
          "ownerUid": {
            ".validate": "newData.val() === $teacherUid"
          },
          "grade": {
            ".validate": "newData.isNumber() && (newData.val() === 10 || newData.val() === 11 || newData.val() === 12)"
          },
          "topic": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "mode": {
            ".validate": "newData.val() === 'classic' || newData.val() === 'speed'"
          },
          "timer": {
            ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 120"
          },
          "questionCount": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "finishedAt": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".validate": "newData.val() === 'finished'"
          },
          "playerCount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "players": {
            "$studentUid": {
              ".validate": "newData.hasChildren(['name', 'section', 'score', 'correct', 'answered', 'rank'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
              },
              "section": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "correct": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "answered": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "rank": {
                ".validate": "newData.isNumber() && newData.val() >= 1"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
